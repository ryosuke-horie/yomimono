{
	"name": "yomimono",
	"version": "0.1.0",
	"private": true,
	"scripts": {
		"preinstall": "npx only-allow pnpm",
		"dev": "next dev",
		"build": "next build",
		"start": "next start",
		"lint": "npx @biomejs/biome check",
		"knip": "knip",
		"typecheck": "tsc --noEmit",
		"format": "npx @biomejs/biome check --write",
		"test": "vitest run",
		"test:coverage": "vitest run --coverage",
		"preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
		"deploy:setup": "bash ./setup-deploy.sh",
		"deploy": "pnpm run deploy:setup && opennextjs-cloudflare build && opennextjs-cloudflare deploy",
		"cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
		"orval": "orval --config orval.config.ts",
		"check:orval": "bash scripts/check-orval-sync.sh"
	},
	"dependencies": {
		"@tanstack/react-query": "^5.101.2",
		"next": "16.2.9",
		"react": "19.2.7",
		"react-dom": "19.2.7",
		"react-icons": "^5.7.0",
		"server-only": "^0.0.1"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.4.14",
		"@cloudflare/workers-types": "^4.20260701.1",
		"@opennextjs/cloudflare": "1.20.1",
		"@tailwindcss/postcss": "^4.3.2",
		"@testing-library/dom": "^10.4.1",
		"@testing-library/jest-dom": "^6.9.1",
		"@testing-library/react": "^16.3.2",
		"@testing-library/user-event": "^14.6.1",
		"@types/node": "^25.6.0",
		"@types/react": "^19.2.17",
		"@types/react-dom": "^19.2.3",
		"@vitejs/plugin-react": "^6.0.1",
		"@vitest/coverage-v8": "^4.1.5",
		"@vitest/ui": "^4.1.5",
		"jsdom": "^29.1.1",
		"knip": "^6.11.0",
		"orval": "^8.9.0",
		"postcss": "^8.5.16",
		"postcss-load-config": "^6.0.1",
		"tailwindcss": "^4.3.2",
		"typescript": "6.0.3",
		"vite": "^8.0.10",
		"vitest": "^4.1.5",
		"wrangler": "^4.106.0"
	},
	"overrides": {
		"@ast-grep/napi": {
			"@ast-grep/napi-linux-x64-gnu": "0.35.0"
		}
	}
}
